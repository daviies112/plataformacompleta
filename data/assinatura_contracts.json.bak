    "contract_html": "\n      <!DOCTYPE html>\n      <html>\n      <head>\n        <meta charset=\"UTF-8\">\n        <title>Contrato de Prestação de Serviços</title>\n        <style>\n          body { font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 40px; color: #333; }\n          .header { padding: 30px; border-radius: 8px; margin-bottom: 30px; }\n          .header h1 { margin: 0; text-align: center; }\n          h1 { color: #2c3e50; text-align: center; border-bottom: 3px solid #333333; padding-bottom: 15px; }\n          h2 { color: #2c3e50; margin-top: 30px; font-size: 20px; }\n          .contract-section { margin: 20px 0; }\n          .signature-section { margin-top: 50px; padding: 20px; border: 2px solid #2c3e50; border-radius: 4px; }\n          .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ccc; text-align: center; font-size: 12px; color: #666; }\n        </style>\n      </head>\n      <body>\n        \n        <div class=\"header\">\n          <h1>Contrato de Prestação de Serviços</h1>\n        </div>\n        \n        <div class=\"contract-section\">\n          <h2>Dados do Contratante</h2>\n          <p><strong>Nome:</strong> {{CLIENT_NAME}}</p>\n          <p><strong>CPF:</strong> {{CLIENT_CPF}}</p>\n          <p><strong>E-mail:</strong> {{CLIENT_EMAIL}}</p>\n          <p><strong>Telefone:</strong> {{CLIENT_PHONE}}</p>\n        </div>\n\n        <div class=\"contract-section\">\n          <h2>Cláusulas</h2>\n          \n        <div style=\"margin-bottom: 20px;\">\n          <h3 style=\"font-weight: bold; margin-bottom: 8px; color: #333333;\">Objeto do Contrato</h3>\n          <p style=\"text-align: justify; line-height: 1.6; font-size: 16px;\">O presente contrato tem por objeto estabelecer os termos e condições para a prestação de serviços entre as partes.</p>\n        </div>\n      \n        <div style=\"margin-bottom: 20px;\">\n          <h3 style=\"font-weight: bold; margin-bottom: 8px; color: #333333;\">Obrigações das Partes</h3>\n          <p style=\"text-align: justify; line-height: 1.6; font-size: 16px;\">As partes comprometem-se a cumprir todas as disposições previstas neste instrumento, agindo sempre com boa-fé e transparência.</p>\n        </div>\n      \n        <div style=\"margin-bottom: 20px;\">\n          <h3 style=\"font-weight: bold; margin-bottom: 8px; color: #333333;\">Prazo de Vigência</h3>\n          <p style=\"text-align: justify; line-height: 1.6; font-size: 16px;\">Este contrato terá vigência pelo prazo acordado entre as partes, podendo ser renovado mediante acordo mútuo.</p>\n        </div>\n      \n        </div>\n\n        <div class=\"signature-section\" id=\"signature-placeholder\">\n        </div>\n        \n        <div class=\"footer\">\n          Documento gerado eletronicamente\n        </div>\n      </body>\n      </html>\n    ",
